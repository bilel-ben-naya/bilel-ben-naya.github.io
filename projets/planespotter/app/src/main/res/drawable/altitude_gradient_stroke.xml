<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">

    <!-- High-contrast altitude gradient used by the legend bar. -->
    <gradient
        android:angle="0"
        android:endColor="#ff2b8cff"
        android:startColor="#ff5b00ff"
        android:type="linear"
        android:centerColor="#ffff3b3b" />

    <corners android:radius="8dp" />

    <!-- Subtle outline so the bar stays visible on light map tiles. -->
    <stroke
        android:width="1dp"
        android:color="#33000000" />
</shape>
